# GigShield — environment configuration template
# Copy to .env and fill in real values. Never commit the real .env file.

# ─── Node environment ──────────────────────────────────────
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000

# ─── MongoDB ────────────────────────────────────────────────
MONGO_USER=gigshield
MONGO_PASS=changeme
MONGO_URI=mongodb://gigshield:changeme@mongo:27017/gigshield?authSource=admin

# ─── Redis ──────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASS=changeme
REDIS_URL=redis://:changeme@redis:6379

# ─── Auth ───────────────────────────────────────────────────
JWT_ACCESS_SECRET=changeme-generate-a-real-random-secret
JWT_REFRESH_SECRET=changeme-generate-a-different-random-secret
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
BCRYPT_ROUNDS=10
ENCRYPTION_KEY=changeme-32-byte-key-for-aes256-encryption

# ─── ML service ─────────────────────────────────────────────
ML_SERVICE_URL=http://ml-service:8000
ML_SERVICE_SECRET=changeme-shared-secret-between-backend-and-ml-service
# Never set this to true outside of automated test environments — it
# disables authentication on the ML service entirely.
ML_SERVICE_TESTING=false

# ─── Weather / AQI data sources ────────────────────────────
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
AQICN_API_KEY=

# ─── Payments (Razorpay) ────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PAYOUT_ACCOUNT=
RAZORPAY_WEBHOOK_SECRET=

# ─── Notifications ──────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_PHONE_FROM=
TWILIO_WHATSAPP_FROM=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── AWS (device fingerprint / KYC document storage) ───────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Blockchain (Sepolia testnet) ──────────────────────────
# Leave all three unset for local dev — blockchainOracle.js falls back to
# an honestly-labeled mock mode automatically when they're not all present.
ETHEREUM_RPC_URL=
ORACLE_PRIVATE_KEY=
GIGSHIELD_CONTRACT_ADDRESS=
LOYALTY_POOL_CONTRACT_ADDRESS=

# ─── IoT (future) ───────────────────────────────────────────
IOT_DEVICE_TOKEN=

# ─── Frontend build-time vars ──────────────────────────────
VITE_API_BASE_URL=http://localhost:5000/api/v1
