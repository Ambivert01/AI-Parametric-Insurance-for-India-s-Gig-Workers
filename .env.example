# ╔══════════════════════════════════════════════════════════════════╗
# ║           GigShield — Environment Configuration Template        ║
# ║                                                                  ║
# ║  HOW TO USE:                                                     ║
# ║  1. Copy this file:  cp .env.example .env                        ║
# ║  2. Fill in values based on LOCAL or PRODUCTION section below    ║
# ║  3. NEVER commit .env to git — it is in .gitignore               ║
# ║                                                                  ║
# ║  LOCAL DEV  → use values from "LOCAL" comments                   ║
# ║  PRODUCTION → use values from "PRODUCTION" comments              ║
# ╚══════════════════════════════════════════════════════════════════╝

# ─── Node Environment ──────────────────────────────────────────────
# LOCAL:      development
# PRODUCTION: production
NODE_ENV=development

PORT=5000
LOG_LEVEL=info

# LOCAL:      http://localhost:3000
# PRODUCTION: https://gigshield-frontend-xxxx.onrender.com  (your Render frontend URL)
ALLOWED_ORIGINS=http://localhost:3000


# ══════════════════════════════════════════════════════════════════
# MONGODB
# ══════════════════════════════════════════════════════════════════
# HOW TO GET:
#   LOCAL OPTION A — Native/Docker MongoDB:
#     Use: mongodb://gigshield:changeme@localhost:27017/gigshield?authSource=admin
#
#   LOCAL OPTION B (Recommended) / PRODUCTION — MongoDB Atlas (Free):
#     1. Go to https://cloud.mongodb.com → Sign up free
#     2. Create a free M0 cluster (512MB)
#     3. Database Access → Add User → username: gigshield, password: <strong-pass>
#     4. Network Access → Add IP → 0.0.0.0/0 (allow all for Render)
#     5. Connect → Drivers → copy connection string
#     6. Replace <password> with your actual password
#     7. Add /gigshield before ? in the URI (database name)
#     Example: mongodb+srv://gigshield:pass@cluster0.xxx.mongodb.net/gigshield?retryWrites=true&w=majority
# ──────────────────────────────────────────────────────────────────
MONGO_USER=gigshield
MONGO_PASS=changeme

# LOCAL (Docker/native):
# MONGO_URI=mongodb://gigshield:changeme@localhost:27017/gigshield?authSource=admin
# PRODUCTION (Atlas):
MONGO_URI=mongodb+srv://gigshield:changeme@cluster0.xxxxx.mongodb.net/gigshield?retryWrites=true&w=majority&appName=Cluster0


# ══════════════════════════════════════════════════════════════════
# REDIS
# ══════════════════════════════════════════════════════════════════
# HOW TO GET:
#   LOCAL — Native Redis (no password needed):
#     Install: sudo apt-get install redis-server  (Ubuntu)
#              brew install redis  (macOS)
#     Start:   sudo systemctl start redis-server
#     Use:     REDIS_HOST=localhost, REDIS_PASS=(leave empty), REDIS_TLS=false
#
#   LOCAL — Docker Redis:
#     docker run -d --name gigshield-redis -p 6379:6379 \
#       redis:7.2-alpine redis-server --requirepass changeme
#     Use:     REDIS_HOST=localhost, REDIS_PASS=changeme
#
#   PRODUCTION — Upstash Redis (Free):
#     1. Go to https://upstash.com → Sign up free
#     2. Create Database → Region: Asia Pacific (Mumbai)
#     3. Details tab → copy Endpoint, Port, Password
#     4. Set REDIS_TLS=true (Upstash requires TLS)
#     5. REDIS_URL format: rediss://default:<password>@<endpoint>:6379
# ──────────────────────────────────────────────────────────────────
# LOCAL:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASS=
# REDIS_URL=redis://localhost:6379
# REDIS_TLS=false

# PRODUCTION (Upstash):
REDIS_HOST=your-upstash-endpoint.upstash.io
REDIS_PORT=6379
REDIS_PASS=your-upstash-password
REDIS_URL=rediss://default:your-upstash-password@your-upstash-endpoint.upstash.io:6379
REDIS_TLS=true


# ══════════════════════════════════════════════════════════════════
# AUTH SECRETS
# ══════════════════════════════════════════════════════════════════
# HOW TO GENERATE (run each command separately):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ⚠️  ENCRYPTION_KEY — CRITICAL:
#   Set this BEFORE your first run and NEVER change it after.
#   If changed, all previously encrypted bank/UPI fields become unreadable.
#   Generate once, store safely.
#
# LOCAL:      any random string works
# PRODUCTION: use properly generated 64-char hex strings (never reuse dev secrets)
# ──────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=changeme-generate-a-real-random-secret
JWT_REFRESH_SECRET=changeme-generate-a-different-random-secret
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
BCRYPT_ROUNDS=10
ENCRYPTION_KEY=changeme-generate-64-char-hex-string-never-change-after-first-run


# ══════════════════════════════════════════════════════════════════
# ML SERVICE
# ══════════════════════════════════════════════════════════════════
# ML_SERVICE_SECRET must be IDENTICAL in both backend and ml-service/.env
# ML_SERVICE_TESTING=true disables auth entirely — NEVER use in production
#
# LOCAL:      http://localhost:8000
# PRODUCTION: https://gigshield-ml-xxxx.onrender.com (your Render ML URL)
# ──────────────────────────────────────────────────────────────────
# LOCAL:
# ML_SERVICE_URL=http://localhost:8000
# PRODUCTION:
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_SECRET=changeme-shared-secret-between-backend-and-ml-service
ML_SERVICE_TESTING=false


# ══════════════════════════════════════════════════════════════════
# WEATHER & AQI APIs
# ══════════════════════════════════════════════════════════════════
# REQUIRED for trigger engine to detect real weather events.
# Without these, app works but trigger engine logs errors and no
# automatic claims are triggered.
#
# OpenWeatherMap (Free — 60 calls/min):
#   1. Go to https://openweathermap.org/api → Sign up free
#   2. Verify email (activation takes ~10 min)
#   3. API Keys tab → copy Default key
#
# AQICN / World Air Quality Index (Free):
#   1. Go to https://aqicn.org/data-platform/token/
#   2. Enter your email → get token in email
# ──────────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
AQICN_API_KEY=


# ══════════════════════════════════════════════════════════════════
# PAYMENTS — RAZORPAY
# ══════════════════════════════════════════════════════════════════
# WITHOUT these: payments run in mock mode (no real money moves).
# Mock mode is fine for demos and local dev.
#
# HOW TO GET (Test/Sandbox keys — free):
#   1. Go to https://razorpay.com → Sign up
#   2. Dashboard → Settings → API Keys → Generate Test Key
#   3. Copy Key ID and Key Secret
#   4. For Payouts: Settings → Payouts → Add Payout Account
#   5. For Webhooks: Settings → Webhooks → Add URL:
#      https://your-backend-url/api/v1/webhooks/razorpay
#
# LOCAL:      Leave blank (mock mode)
# PRODUCTION: Fill in test keys first, then live keys when ready
# ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PAYOUT_ACCOUNT=
RAZORPAY_WEBHOOK_SECRET=


# ══════════════════════════════════════════════════════════════════
# NOTIFICATIONS — TWILIO (SMS/OTP/WhatsApp)
# ══════════════════════════════════════════════════════════════════
# WITHOUT these: OTPs print to backend console (dev mode).
# Console OTP format: [DEV] OTP for ***0001: 482913
#
# HOW TO GET (Free trial — $15 credit):
#   1. Go to https://www.twilio.com → Sign up free
#   2. Console → Account SID + Auth Token (copy both)
#   3. Phone Numbers → Buy a number (use trial credit)
#   4. Verify Service: Console → Verify → Services → Create
#      Copy Service SID → TWILIO_VERIFY_SERVICE_SID
#   5. For WhatsApp: Console → Messaging → WhatsApp Sandbox
#      Copy sandbox number → TWILIO_WHATSAPP_FROM (format: whatsapp:+14155238886)
#
# LOCAL:      Leave blank (OTP logs to console)
# PRODUCTION: Fill in for real OTP delivery
# ──────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_PHONE_FROM=
TWILIO_WHATSAPP_FROM=


# ══════════════════════════════════════════════════════════════════
# PUSH NOTIFICATIONS — FIREBASE (FCM)
# ══════════════════════════════════════════════════════════════════
# WITHOUT these: push notifications are skipped silently.
#
# HOW TO GET (Free):
#   1. Go to https://console.firebase.google.com → Create Project
#   2. Project Settings → Service Accounts → Generate New Private Key
#   3. Download JSON file → extract these fields:
#      project_id → FIREBASE_PROJECT_ID
#      client_email → FIREBASE_CLIENT_EMAIL
#      private_key → FIREBASE_PRIVATE_KEY (keep \n escape chars, wrap in quotes)
#
# LOCAL:      Leave blank
# PRODUCTION: Fill in for real push notifications
# ──────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=


# ══════════════════════════════════════════════════════════════════
# AWS (KYC Document Storage)
# ══════════════════════════════════════════════════════════════════
# WITHOUT these: KYC document uploads are mocked locally.
#
# HOW TO GET (Free tier — 5GB S3):
#   1. Go to https://aws.amazon.com → Create account
#   2. IAM → Users → Create User → Attach S3FullAccess policy
#   3. Security Credentials → Create Access Key → copy both
#   4. S3 → Create Bucket → gigshield-kyc-docs
#
# LOCAL:      Leave blank
# PRODUCTION: Optional — fill in for real KYC storage
# ──────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=


# ══════════════════════════════════════════════════════════════════
# BLOCKCHAIN — Ethereum Sepolia Testnet
# ══════════════════════════════════════════════════════════════════
# WITHOUT these: blockchain logging runs in mock mode (labeled as
# such in UI — never presented as real).
#
# HOW TO GET (Free testnet):
#   1. Infura: https://infura.io → Sign up → Create Project →
#      Copy Sepolia endpoint → ETHEREUM_RPC_URL
#      Format: https://sepolia.infura.io/v3/your-project-id
#
#   2. Wallet Private Key:
#      MetaMask → Account Details → Export Private Key
#      Fund with Sepolia ETH: https://sepoliafaucet.com
#
#   3. Deploy contracts first:
#      cd blockchain && npm run deploy:sepolia
#      Copy deployed addresses → CONTRACT_ADDRESS vars
#
# LOCAL:      Leave blank (mock mode)
# PRODUCTION: Fill in for on-chain audit trail
# ──────────────────────────────────────────────────────────────────
ETHEREUM_RPC_URL=
ORACLE_PRIVATE_KEY=
GIGSHIELD_CONTRACT_ADDRESS=
LOYALTY_POOL_CONTRACT_ADDRESS=


# ══════════════════════════════════════════════════════════════════
# IoT (Future Phase)
# ══════════════════════════════════════════════════════════════════
IOT_DEVICE_TOKEN=


# ══════════════════════════════════════════════════════════════════
# FRONTEND BUILD-TIME VARIABLES
# ══════════════════════════════════════════════════════════════════
# These are embedded at BUILD TIME by Vite — changing them requires
# a full frontend rebuild/redeploy.
#
# LOCAL:      http://localhost:5000/api/v1
# PRODUCTION: https://gigshield-backend-xxxx.onrender.com/api/v1
# ──────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000/api/v1
